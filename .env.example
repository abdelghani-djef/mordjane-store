# Docker Compose settings. Copy to .env and fill in; .env is not committed.

# Database (mordjane-db, reachable from the host on 127.0.0.1:5434)
POSTGRES_DB=mordjane
POSTGRES_USER=mordjane
POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Secure cookies need HTTPS (browsers also accept them on http://localhost).
COOKIE_SECURE=true

# Public address of the shop, used for links in emails.
PUBLIC_SITE_URL=http://localhost:3000

# Host port for the storefront (mordjane-front).
FRONT_PORT=3000

# Email (see README → Production SMTP). MAIL_ENABLED=false logs emails instead of sending.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
# Leave these commented out if your SMTP server needs no login.
# SMTP_USERNAME=
# SMTP_PASSWORD=
MAIL_FROM=Mordjane <orders@example.com>

