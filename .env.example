# Docker Compose settings. Copy to .env and fill in; .env is not committed.

# Database (mordjane-db, reachable from the host on 127.0.0.1:5434)
POSTGRES_DB=mordjane
POSTGRES_USER=mordjane
POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Secure cookies need HTTPS (browsers also accept them on http://localhost).
COOKIE_SECURE=true

# Public address of the shop, used for links in emails.
PUBLIC_SITE_URL=http://localhost:3000

# Host port for the storefront (mordjane-front).
FRONT_PORT=3000

# Email, sent through Resend (see README → Sending email). The username is literally
# "resend"; the password is a Resend API key (re_…). MAIL_FROM must be on a domain
# verified in Resend.
MAIL_FROM=Mordjane <noreply@mordjane.tn>
SMTP_USERNAME=resend
SMTP_PASSWORD=
# If the server's host blocks port 587, Resend also listens on 2587.
# SMTP_PORT=2587
# MAIL_ENABLED=false logs emails instead of sending them.
MAIL_ENABLED=true
