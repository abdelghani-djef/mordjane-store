# Docker Compose settings. Copy to .env and fill in; .env is not committed.

# Database (mordjane-db, reachable from the host on 127.0.0.1:5434)
POSTGRES_DB=mordjane
POSTGRES_USER=mordjane
POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Secure cookies need HTTPS (browsers also accept them on http://localhost).
COOKIE_SECURE=true

# Public address of the shop, used for links in emails.
PUBLIC_SITE_URL=http://localhost:3000

# Host port for the storefront (mordjane-front).
FRONT_PORT=3000

# Email. mordjane-mail sends as anything@MAIL_DOMAIN; see README → Mail server for the
# DNS records it needs (SPF, DKIM, DMARC, reverse DNS).
MAIL_DOMAIN=mordjane.tn
# Send-only: nobody reads replies, so use a no-reply address.
MAIL_FROM=Mordjane <noreply@mordjane.tn>
# Name the server introduces itself with; must match the server IP's reverse DNS.
# MAIL_HOSTNAME=mail.mordjane.tn
# MAIL_ENABLED=false logs emails instead of sending them.
MAIL_ENABLED=true

# Optional: relay through a provider (Brevo, Mailgun, SES…) if port 25 is blocked.
# RELAYHOST=[smtp-relay.brevo.com]:587
# RELAYHOST_USERNAME=
# RELAYHOST_PASSWORD=
